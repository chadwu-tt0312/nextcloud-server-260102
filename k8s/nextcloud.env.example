# Nextcloud + MariaDB 共用環境變數（複製為 nextcloud.env 並填入實際值，勿提交）
# kubectl create secret generic nextcloud-env --from-env-file=nextcloud.env -n <namespace>

# MariaDB
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_PASSWORD=your_nextcloud_db_password
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud

# Nextcloud 應用（MYSQL_* 供 DB 連線；NC_* 會覆寫 config.php，敏感資料建議只放 env）
# MYSQL_HOST 為 K8s Service 名稱
MYSQL_HOST=nextcloud-db
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=your_admin_password

# NC_* 會覆寫 config.php 同名字鍵（見 lib/private/Config.php），可將 DB/密鑰等移出 config 檔
NC_dbhost=nextcloud-db
NC_dbname=nextcloud
NC_dbuser=nextcloud
NC_dbpassword=your_nextcloud_db_password
# 以下為安裝時產生，若 config.php 已刪除則必填（可從既有安裝的 config.php 複製一次）
NC_passwordsalt=SYXgn1Wr17y09KHwqVDwkaIIbOaR84
NC_secret=rSAX7DTmGiDquJCeExbr2IaDr3fsL+XeI4FJHUlTGjYxc1P7
NC_instanceid=oczkw2mdhxj5
