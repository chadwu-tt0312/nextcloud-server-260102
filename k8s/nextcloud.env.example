# Nextcloud + MariaDB 共用環境變數（複製為 nextcloud.env 並填入實際值，勿提交）
# kubectl create secret generic nextcloud-env --from-env-file=nextcloud.env -n <namespace>

# MariaDB
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_PASSWORD=your_nextcloud_db_password
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud

# Nextcloud 應用（MYSQL_HOST 為 K8s Service 名稱）
MYSQL_HOST=nextcloud-db
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=your_admin_password
