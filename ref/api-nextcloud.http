### 2. GET an existing external storage
curl -X GET "http://localhost:8085/apps/files_external/globalstorages/10" \
  -u "{{ADMIN_INFO}}" \
  -H "OCS-APIRequest: true"

### 3. Create a new S3 external storage  
curl -X POST "http://localhost:8085/apps/files_external/globalstorages" \
  -u "{{ADMIN_INFO}}" \
  -H "OCS-APIRequest: true" \
  -H "Content-Type: application/json" \
  -d '{
    "mountPoint": "/minio-DEPT_SMG_ARC1",
    "backend": "amazons3",
    "authMechanism": "amazons3::accesskey",
    "backendOptions": {
      "bucket": "dep-smg-arc1-filespace",
      "hostname": "192.168.31.180",
      "port": "9000",
      "region": "us-east-1",
      "use_ssl": false,
      "use_path_style": true,
      "legacy_auth": false,
      "useMultipartCopy": true,
      "key": "{{ACCESS_KEY}}",
      "secret": "{{SECRET_KEY}}"
    },
    "mountOptions": {},
    "applicableUsers": [],
    "applicableGroups": []
  }'

# --- response 201 ---
{
  "id": 12,
  "mountPoint": "\/minio-DEPT_SMG_ARC1",
  "backend": "amazons3",
  "authMechanism": "amazons3::accesskey",
  "backendOptions": {
    "bucket": "dep-smg-arc1-filespace",
    "hostname": "192.168.31.180",
    "port": "9000",
    "region": "us-east-1",
    "use_ssl": false,
    "use_path_style": true,
    "legacy_auth": false,
    "useMultipartCopy": true,
    "key": "ZEPNGTC059NIHD4KHYVW",
    "secret": "__unmodified__"
  },
  "status": 0,
  "userProvided": false,
  "type": "system"
}

### 4. Create a new local external storage  
curl -X POST "http://localhost:8085/apps/files_external/globalstorages" \
  -u "{{ADMIN_INFO}}" \
  -H "OCS-APIRequest: true" \
  -H "Content-Type: application/json" \
  -d '{
  "mountPoint": "Local-API-path011",
  "backend": "local",
  "authMechanism": "null",
  "backendOptions": {
    "datadir": "/var/local/path001/path011"
  }
}'

### 5. Update an existing external storage (ID: 10)
curl -X PUT "http://localhost:8085/apps/files_external/globalstorages/10" \
  -u "admin:password123" \
  -H "OCS-APIRequest: true" \
  -H "Content-Type: application/json" \
  -d '{
    "mountPoint": "/minio-DEPT_SMG_ARC1-upd",
    "backend": "amazons3",
    "authMechanism": "amazons3::accesskey",
    "backendOptions": {
      "bucket": "dep-smg-arc1-filespace",
      "hostname": "192.168.31.180",
      "port": "9000",
      "region": "us-east-123",
      "use_ssl": false,
      "use_path_style": true,
      "legacy_auth": false,
      "useMultipartCopy": true,
      "key": "{{ACCESS_KEY}}",
      "secret": "{{SECRET_KEY}}"
    }
  }'

### 6. Delete an existing external storage (ID: 12)
curl -X DELETE "http://localhost:8085/apps/files_external/globalstorages/12" \
  -u "admin:password123" \
  -H "OCS-APIRequest: true"

# --- response 204 (No Content) ---