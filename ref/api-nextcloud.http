### 2. GET an existing external storage
curl -X GET "http://localhost:8085/apps/files_external/globalstorages/10" \
  -u "{{ADMIN_INFO}}" \
  -H "OCS-APIRequest: true"

### 3. Create a new S3 external storage  
curl -X POST "http://localhost:8085/apps/files_external/globalstorages" \
  -u "{{ADMIN_INFO}}" \
  -H "OCS-APIRequest: true" \
  -H "Content-Type: application/json" \
  -d '{
    "mountPoint": "/minio-SMG_ARC304",
    "backend": "amazons3",
    "authMechanism": "amazons3::accesskey",
    "backendOptions": {
      "bucket": "smg-arc304-filespace",
      "hostname": "192.168.31.180",
      "port": "9000",
      "region": "us-east-1",
      "use_ssl": false,
      "use_path_style": true,
      "legacy_auth": false,
      "useMultipartCopy": true,
      "key": "{{ACCESS_KEY}}",
      "secret": "{{SECRET_KEY}}"
    },
    "mountOptions": {},
    "applicableUsers": ["SMG_ARC304"],
    "applicableGroups": []
  }'

# --- response 201 ---
{
  "id": 12,
  "mountPoint": "\/minio-DEPT_SMG_ARC1",
  "backend": "amazons3",
  "authMechanism": "amazons3::accesskey",
  "backendOptions": {
    "bucket": "dep-smg-arc1-filespace",
    "hostname": "192.168.31.180",
    "port": "9000",
    "region": "us-east-1",
    "use_ssl": false,
    "use_path_style": true,
    "legacy_auth": false,
    "useMultipartCopy": true,
    "key": "ZEPNGTC059NIHD4KHYVW",
    "secret": "__unmodified__"
  },
  "status": 0,
  "userProvided": false,
  "type": "system"
}

### 4. Create a new local external storage  
curl -X POST "http://localhost:8085/apps/files_external/globalstorages" \
  -u "{{ADMIN_INFO}}" \
  -H "OCS-APIRequest: true" \
  -H "Content-Type: application/json" \
  -d '{
  "mountPoint": "Local-API-path011",
  "backend": "local",
  "authMechanism": "null",
  "backendOptions": {
    "datadir": "/var/local/path001/path011"
  }
}'

### 5. Update an existing external storage (ID: 10)
curl -X PUT "http://localhost:8085/apps/files_external/globalstorages/10" \
  -u "{{ADMIN_INFO}}" \
  -H "OCS-APIRequest: true" \
  -H "Content-Type: application/json" \
  -d '{
    "mountPoint": "/minio-DEPT_SMG_ARC1-upd",
    "backend": "amazons3",
    "authMechanism": "amazons3::accesskey",
    "backendOptions": {
      "bucket": "dep-smg-arc1-filespace",
      "hostname": "192.168.31.180",
      "port": "9000",
      "region": "us-east-123",
      "use_ssl": false,
      "use_path_style": true,
      "legacy_auth": false,
      "useMultipartCopy": true,
      "key": "{{ACCESS_KEY}}",
      "secret": "{{SECRET_KEY}}"
    }
  }'

### 6. Delete an existing external storage (ID: 12)
curl -X DELETE "http://localhost:8085/apps/files_external/globalstorages/12" \
  -u "{{ADMIN_INFO}}" \
  -H "OCS-APIRequest: true"

# --- response 204 (No Content) ---

### 7. Get User(SMG_ARC304) UID
curl -X GET "http://localhost:8085/ocs/v1.php/cloud/users?search=SMG_ARC304&format=json" \
  -u "{{ADMIN_INFO}}" \
  -H "OCS-APIRequest: true" \
  -H "Accept: application/json"

### 7.1. Get User(00059094) UID
curl -X GET "http://localhost:8085/ocs/v1.php/cloud/users?search=Hui%20Yu%20Huang&format=json" \
  -u "{{ADMIN_INFO}}" \
  -H "OCS-APIRequest: true" \
  -H "Accept: application/json"

### 7.2. Get User(00059094) UID
curl -X GET "http://localhost:8085/ocs/v1.php/cloud/users?search=00059094&format=json" \
  -u "{{ADMIN_INFO}}" \
  -H "OCS-APIRequest: true" \
  -H "Accept: application/json"

### 列出所有使用者 UID
curl "http://localhost:8085/ocs/v2.php/cloud/users?format=json" \
  -u "{{ADMIN_INFO}}" \
  -H "OCS-APIRequest: true"

### 搜尋特定使用者（用 search 參數）
curl "http://localhost:8085/ocs/v2.php/cloud/users?search=00059094&format=json" \
  -u "{{ADMIN_INFO}}" \
  -H "OCS-APIRequest: true"

### 取得特定使用者的詳細資訊（含 UID、email、displayname 等）
curl "http://localhost:8085/ocs/v2.php/cloud/users/00059094?format=json" \
  -u "{{ADMIN_INFO}}" \
  -H "OCS-APIRequest: true"

### 8. 建立新使用者（建立時即設 quota=0 B，避免 skeleton 佔用約 54.8MB）
# Body 為 form-urlencoded，非 JSON。建議搭配系統設定 skeletondirectory=""（見 tools/README.md）
curl -X POST "http://localhost:8085/ocs/v2.php/cloud/users" \
  -u "{{ADMIN_INFO}}" \
  -H "OCS-APIRequest: true" \
  -H "Accept: application/json" \
  -d "userid=00059094" \
  -d "password=ChangeMe123!" \
  -d "displayName=00059094" \
  -d "quota=0%20B"

# --- response 200 (OCS statuscode 100) ---
# {"ocs":{"meta":{"status":"ok","statuscode":100},"data":{"id":"00059094"}}}

### 8.1 修改既有使用者的 quota（等同 set_user_quota.py）
curl -X PUT "http://localhost:8085/ocs/v2.php/cloud/users/00059094" \
  -u "{{ADMIN_INFO}}" \
  -H "OCS-APIRequest: true" \
  -H "Accept: application/json" \
  -d "key=quota" \
  -d "value=0%20B"
